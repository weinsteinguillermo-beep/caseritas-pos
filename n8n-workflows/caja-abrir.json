        "jsCode": "function fail(message) { return [{ json: { ok: false, message } }]; }\nlet body;\ntry {\n  const raw = $json.body || $json;\n  body = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (error) {\n  return fail('La solicitud no tiene formato valido.');\n}\nconst operationId = String(body.operationId || '').trim();\nconst empresaId = String(body.empresaId || '').trim();\nconst usuarioId = String(body.usuarioId || '').trim();\nconst cajaId = String(body.cajaId || '').trim();\nconst fondoInicial = Number(body.fondoInicial || 0);\nif (!operationId) return fail('Falta operationId.');\nif (!empresaId) return fail('Falta empresaId.');\nif (!usuarioId) return fail('Falta usuarioId.');\nif (!cajaId) return fail('Falta cajaId.');\nif (!Number.isFinite(fondoInicial) || fondoInicial < 0) return fail('El fondo inicial debe ser mayor o igual a cero.');\nconst esc = (value) => String(value).replace(/\"/g, '\\\\\"');\nreturn [{ json: { ok: true, operationId, empresaId, usuarioId, cajaId, fondoInicial, fechaHora: body.fechaHora || new Date().toISOString(), duplicateFormula: '{operation_id_apertura} = \"' + esc(operationId) + '\"', openFormula: 'AND({empresa_id} = \"' + esc(empresaId) + '\", {usuario_id} = \"' + esc(usuarioId) + '\", {caja_id} = \"' + esc(cajaId) + '\", {estado} = \"ABIERTA\")' } }];"
