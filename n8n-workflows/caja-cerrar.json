      "parameters": {
        "jsCode": "const data=$items('Resolver Idempotencia')[0].json; const sessionItem=$items('Buscar Sesion').find(item=>item.json&&item.json.id); if(!sessionItem)return [{json:{ok:false,message:'La caja no existe.'}}]; const session=sessionItem.json.fields||sessionItem.json; if(session.estado !== 'ABIERTA') return [{json:{ok:false,message:'La caja ya esta cerrada.'}}]; if(String(session.usuario_id||'') !== data.usuarioId) return [{json:{ok:false,message:'No se puede cerrar una caja de otro usuario.'}}];\nconst moves=$items('Buscar Movimientos Caja').filter(item=>item.json&&item.json.id).map(item=>item.json.fields||item.json); const fondo=Number(session.fondo_inicial||0); const ingresos=moves.filter(m=>m.tipo==='INGRESO').reduce((s,m)=>s+Number(m.importe||0),0); const egresos=moves.filter(m=>m.tipo==='EGRESO').reduce((s,m)=>s+Number(m.importe||0),0); const totalEsperado=fondo+ingresos-egresos; const diferencia=data.totalContado-totalEsperado;\nreturn [{json:{id:data.cajaSesionId,estado:'CERRADA',fecha_cierre:data.fechaHora,total_esperado:totalEsperado,total_contado:data.totalContado,diferencia,observaciones:data.observaciones,operation_id_cierre:data.operationId}}];"
