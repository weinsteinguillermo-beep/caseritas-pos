        "jsCode": "function fail(message){return [{json:{ok:false,message}}];}\nlet body; try { const raw=$json.body||$json; body=typeof raw==='string'?JSON.parse(raw):raw; } catch(e){ return fail('La solicitud no tiene formato valido.'); }\nconst operationId=String(body.operationId||'').trim(); const empresaId=String(body.empresaId||'').trim(); const usuarioId=String(body.usuarioId||'').trim(); const cajaSesionId=String(body.cajaSesionId||'').trim(); const totalContado=Number(body.totalContado||0);\nif(!operationId)return fail('Falta operationId.'); if(!empresaId)return fail('Falta empresaId.'); if(!usuarioId)return fail('Falta usuarioId.'); if(!cajaSesionId)return fail('Falta cajaSesionId.'); if(!Number.isFinite(totalContado)||totalContado<0)return fail('Total contado invalido.');\nconst esc=(v)=>String(v).replace(/\"/g,'\\\\\"');\nreturn [{json:{ok:true,operationId,empresaId,usuarioId,cajaSesionId,totalContado,observaciones:String(body.observaciones||''),fechaHora:body.fechaHora||new Date().toISOString(),closeFormula:'{operation_id_cierre} = \"'+esc(operationId)+'\"',sessionFormula:'RECORD_ID() = \"'+esc(cajaSesionId)+'\"',movementFormula:'AND({caja_sesion_id} = \"'+esc(cajaSesionId)+'\", {estado} = \"CONFIRMADO\")'}}];"
      },
