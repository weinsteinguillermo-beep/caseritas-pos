        "jsCode": "let body;\ntry { const raw = $json.body || $json.query || $json; body = typeof raw === 'string' ? JSON.parse(raw) : raw; } catch (e) { body = {}; }\nconst empresaId = String(body.empresaId || '').trim();\nconst usuarioId = String(body.usuarioId || '').trim();\nconst cajaId = String(body.cajaId || '').trim();\nif (!empresaId || !usuarioId || !cajaId) return [{ json: { ok: false, message: 'Faltan datos para consultar caja.' } }];\nconst esc = (value) => String(value).replace(/\"/g, '\\\\\"');\nreturn [{ json: { ok: true, formula: 'AND({empresa_id} = \"' + esc(empresaId) + '\", {usuario_id} = \"' + esc(usuarioId) + '\", {caja_id} = \"' + esc(cajaId) + '\", {estado} = \"ABIERTA\")' } }];"
