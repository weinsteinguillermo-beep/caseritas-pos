    {
      "parameters": {
        "jsCode": "function fail(message){return [{json:{ok:false,message}}];}\nlet body; try { const raw=$json.body||$json; body=typeof raw==='string'?JSON.parse(raw):raw; } catch(e){ return fail('La solicitud no tiene formato valido.'); }\nconst operationId=String(body.operationId||'').trim(); const empresaId=String(body.empresaId||'').trim(); const usuarioId=String(body.usuarioId||'').trim(); const cajaSesionId=String(body.cajaSesionId||'').trim(); const tipo=String(body.tipo||'').trim().toUpperCase(); const importe=Number(body.importe||0); const motivo=String(body.motivo||'').trim();\nif(!operationId)return fail('Falta operationId.'); if(!empresaId)return fail('Falta empresaId.'); if(!usuarioId)return fail('Falta usuarioId.'); if(!cajaSesionId)return fail('Falta cajaSesionId.'); if(!['INGRESO','EGRESO'].includes(tipo))return fail('Tipo de movimiento invalido.'); if(!Number.isFinite(importe)||importe<=0)return fail('El importe debe ser mayor que cero.'); if(!motivo)return fail('Falta motivo.');\nconst esc=(v)=>String(v).replace(/\"/g,'\\\\\"');\nreturn [{json:{ok:true,operationId,empresaId,usuarioId,cajaSesionId,tipo,importe,motivo,fechaHora:body.fechaHora||new Date().toISOString(),duplicateFormula:'{operation_id} = \"'+esc(operationId)+'\"',sessionFormula:'AND(RECORD_ID() = \"'+esc(cajaSesionId)+'\", {estado} = \"ABIERTA\")'}}];"
      },
