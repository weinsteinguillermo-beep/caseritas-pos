        "jsCode": "function fail(message){return [{json:{ok:false,message}}];}\nlet body; try{const raw=$json.body||$json; body=typeof raw==='string'?JSON.parse(raw):raw;}catch(e){return fail('La solicitud no tiene formato valido.');}\nconst operationId=String(body.operationId||'').trim(); const empresaId=String(body.empresaId||'').trim(); const usuarioId=String(body.usuarioId||'').trim(); const cajaSesionId=String(body.cajaSesionId||'').trim(); const ventaId=String(body.ventaId||'').trim(); const motivo=String(body.motivo||'').trim();\nif(!operationId)return fail('Falta operationId.'); if(!empresaId)return fail('Falta empresaId.'); if(!usuarioId)return fail('Falta usuarioId.'); if(!ventaId)return fail('Falta ventaId.'); if(!motivo)return fail('El motivo es obligatorio.');\nconst esc=(v)=>String(v).replace(/\"/g,'\\\\\"');\nreturn [{json:{ok:true,operationId,empresaId,usuarioId,cajaSesionId,ventaId,motivo,fechaHora:body.fechaHora||new Date().toISOString(),duplicateFormula:'{AnulacionOperationId} = \"'+esc(operationId)+'\"',saleFormula:'AND(RECORD_ID() = \"'+esc(ventaId)+'\", {EmpresaId} = \"'+esc(empresaId)+'\")',stockFormula:'AND(FIND(\"'+esc(ventaId)+'\", ARRAYJOIN({Venta})), {Tipo} = \"VENTA\", {Estado} = \"ACTIVO\")',cajaFormula:'AND({venta_id} = \"'+esc(ventaId)+'\", {origen} = \"VENTA\", {estado} = \"ACTIVO\")'}}];"
