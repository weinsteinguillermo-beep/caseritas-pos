        "jsCode": "function fail(message){return [{json:{ok:false,message}}];}\nlet body; try{const raw=$json.body||$json; body=typeof raw==='string'?JSON.parse(raw):raw;}catch(e){return fail('La solicitud no tiene formato valido.');}\nconst empresaId=String(body.empresaId||'').trim(); const ventaId=String(body.ventaId||'').trim();\nif(!empresaId)return fail('Falta empresaId.'); if(!ventaId)return fail('Falta ventaId.');\nconst esc=(v)=>String(v).replace(/\"/g,'\\\\\"');\nreturn [{json:{ok:true,empresaId,ventaId,saleFormula:'AND(RECORD_ID() = \"'+esc(ventaId)+'\", {EmpresaId} = \"'+esc(empresaId)+'\")', detailFormula:'FIND(\"'+esc(ventaId)+'\", ARRAYJOIN({Venta}))', stockFormula:'FIND(\"'+esc(ventaId)+'\", ARRAYJOIN({Venta}))', cajaFormula:'{venta_id} = \"'+esc(ventaId)+'\"'}}];"
