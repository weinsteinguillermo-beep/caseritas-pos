      "parameters": {
        "jsCode": "const saleItem=$items('Buscar Venta').find(item=>item.json&&item.json.id); if(!saleItem)return [{json:{ok:false,message:'La venta no existe o no pertenece a la empresa.'}}];\nconst f=saleItem.json.fields||saleItem.json;\nconst detalle=$items('Buscar Detalle').filter(i=>i.json&&i.json.id).map(i=>{const d=i.json.fields||i.json; return {detalleId:i.json.id, productoId:Array.isArray(d.Producto)?d.Producto[0]:d.Producto, producto:d.ProductoNombre, codigoBarras:d.CodigoBarras, cantidad:Number(d.Cantidad||0), precioUnitario:Number(d.PrecioUnitario||0), totalLinea:Number(d.TotalLinea||0), estado:d.Estado};});\nconst movimientosStock=$items('Buscar Movimientos Stock').filter(i=>i.json&&i.json.id).map(i=>({movimientoStockId:i.json.id,...(i.json.fields||i.json)}));\nconst movimientosCaja=$items('Buscar Movimientos Caja').filter(i=>i.json&&i.json.id).map(i=>({movimientoCajaId:i.json.id,...(i.json.fields||i.json)}));\nreturn [{json:{ok:true,venta:{ventaId:saleItem.json.id,operationId:f.OperationId||'',empresaId:f.EmpresaId||'',usuarioId:f.UsuarioId||f.Cajero||'',cajaSesionId:f.CajaSesionId||'',fechaHora:f.Fecha||'',cliente:f.ClienteNombre||'Consumidor final',formaPago:f.MetodoPago||'',subtotal:Number(f.Subtotal||0),total:Number(f.Total||0),estado:String(f.Estado||'').toUpperCase(),anulacion:{operationId:f.AnulacionOperationId||'',motivo:f.MotivoAnulacion||'',usuarioId:f.AnuladoPor||'',fechaHora:f.FechaAnulacion||''}},detalle,movimientosStock,movimientosCaja}}];"
      },
