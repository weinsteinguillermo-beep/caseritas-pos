      "id": "airtable-venta",
      "name": "Airtable",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.1,
      "position": [480, 0]
    },
    {
      "parameters": {
        "jsCode": "const venta = $items('Validacion')[0].json;\nconst ventaCreada = $items('Airtable')[0].json;\nreturn [{\n  json: {\n    Fecha: venta.Fecha,\n    Tipo: 'Ingreso',\n    Concepto: 'Venta POS',\n    MetodoPago: venta.MetodoPago,\n    Importe: venta.Total,\n    VentaId: ventaCreada.id,\n    Estado: 'Confirmado'\n  }\n}];"
      },
