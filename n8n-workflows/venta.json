      "webhookId": "caseritas-venta"
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.body || $json;\nconst sale = typeof raw === 'string' ? JSON.parse(raw) : raw;\nif (!Array.isArray(sale.items) || sale.items.length === 0) {\n  throw new Error('La venta no tiene productos.');\n}\nif (!sale.paymentMethod) {\n  throw new Error('Selecciona un metodo de pago.');\n}\nconst total = Number(sale.total || 0);\nif (!Number.isFinite(total) || total <= 0) {\n  throw new Error('El total de la venta no es valido.');\n}\nreturn [{\n  json: {\n    Fecha: sale.createdAt || new Date().toISOString(),\n    MetodoPago: sale.paymentMethod,\n    Subtotal: Number(sale.subtotal || 0),\n    DescuentoPorcentaje: Number(sale.discountPercent || 0),\n    DescuentoImporte: Number(sale.discountAmount || 0),\n    Total: total,\n    EfectivoRecibido: Number(sale.cashReceived || 0),\n    ItemsJSON: JSON.stringify(sale.items),\n    Estado: 'Registrada'\n  }\n}];"
      },
      "id": "validacion-venta",
      "name": "Validacion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "operation": "create",
        "base": {
