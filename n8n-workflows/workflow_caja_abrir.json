                      "parameters":  {
                                         "jsCode":  "const source = $json.body ?? $json;\nlet body = source;\n\nif (typeof body === \u0027string\u0027) {\n  try {\n    body = JSON.parse(body);\n  } catch (error) {\n    body = {};\n  }\n}\n\nconst operationId = String(body.operationId || \u0027\u0027).trim();\nconst empresaId = String(body.empresaId || \u0027\u0027).trim();\nconst usuarioId = String(body.usuarioId || \u0027\u0027).trim();\nconst cajaId = String(body.cajaId || \u0027\u0027).trim();\nconst hasFondoInicial = body.fondoInicial !== undefined \u0026\u0026 body.fondoInicial !== null \u0026\u0026 String(body.fondoInicial).trim() !== \u0027\u0027;\nconst fondoInicial = Number(body.fondoInicial);\n\nif (!operationId || !empresaId || !usuarioId || !cajaId || !hasFondoInicial) {\n  return [\n    {\n      json: {\n        ok: false,\n        error: \u0027INVALID_PAYLOAD\u0027,\n        message: \u0027Faltan datos obligatorios para abrir la caja\u0027\n      }\n    }\n  ];\n}\n\nif (!Number.isFinite(fondoInicial) || fondoInicial \u003c 0) {\n  return [\n    {\n      json: {\n        ok: false,\n        error: \u0027INVALID_OPENING_BALANCE\u0027,\n        message: \u0027El fondo inicial debe ser un importe valido\u0027\n      }\n    }\n  ];\n}\n\nconst inputDate = body.fechaHora ? new Date(body.fechaHora) : new Date();\nconst fechaHora = Number.isNaN(inputDate.getTime()) ? new Date().toISOString() : inputDate.toISOString();\nconst escapeFormula = (value) =\u003e String(value).replace(/\\\\/g, \u0027\\\\\\\\\u0027).replace(/\"/g, \u0027\\\\\"\u0027);\n\nreturn [\n  {\n    json: {\n      ok: true,\n      operationId,\n      empresaId,\n      usuarioId,\n      cajaId,\n      fondoInicial,\n      fechaHora,\n      operationFormula: `({operation_id_apertura} \u0026 \"\") = \"${escapeFormula(operationId)}\"`,\n      openFormula: `AND(({empresa_id} \u0026 \"\") = \"${escapeFormula(empresaId)}\", ({usuario_id} \u0026 \"\") = \"${escapeFormula(usuarioId)}\", ({caja_id} \u0026 \"\") = \"${escapeFormula(cajaId)}\", ({estado} \u0026 \"\") = \"ABIERTA\")`\n    }\n  }\n];"
                                     },
