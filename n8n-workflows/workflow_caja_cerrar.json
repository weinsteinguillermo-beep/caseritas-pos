                                         "jsCode":  "try {\n  const data = $items(\u0027DecidirIdempotencia\u0027)[0]?.json || {};\n  const rows = $items(\u0027BuscarSesion\u0027);\n  const queryError = rows.find((item) =\u003e item.json \u0026\u0026 (item.json.error || item.json.message) \u0026\u0026 !item.json.id);\n  if (queryError) {\n    return [{ json: { ok: false, sessionValid: false, error: \u0027CASH_CLOSE_ERROR\u0027, message: \u0027No se pudo cerrar la caja\u0027 } }];\n  }\n  const sessionItem = rows.find((item) =\u003e item.json \u0026\u0026 item.json.id);\n  if (!sessionItem) {\n    return [{ json: { ok: false, sessionValid: false, error: \u0027CASH_SESSION_NOT_FOUND\u0027, message: \u0027No se encontro la sesion de caja\u0027 } }];\n  }\n  const session = sessionItem.json.fields || sessionItem.json;\n  const estado = String(session.estado || \u0027\u0027).toUpperCase();\n  const sameEmpresa = String(session.empresa_id || \u0027\u0027) === data.empresaId;\n  const sameUsuario = String(session.usuario_id || \u0027\u0027) === data.usuarioId;\n  const sameCaja = !data.cajaId || String(session.caja_id || \u0027\u0027) === data.cajaId;\n\n  if (!sameEmpresa || !sameUsuario || !sameCaja) {\n    return [{ json: { ok: false, sessionValid: false, error: \u0027CASH_SESSION_MISMATCH\u0027, message: \u0027La sesion de caja no corresponde a esta operacion\u0027 } }];\n  }\n  if (estado === \u0027CERRADA\u0027) {\n    return [{ json: { ok: false, sessionValid: false, error: \u0027CASH_REGISTER_ALREADY_CLOSED\u0027, message: \u0027La caja ya se encuentra cerrada\u0027 } }];\n  }\n  if (estado !== \u0027ABIERTA\u0027) {\n    return [{ json: { ok: false, sessionValid: false, error: \u0027CASH_SESSION_NOT_FOUND\u0027, message: \u0027No se encontro la sesion de caja\u0027 } }];\n  }\n\n  return [{ json: { ...data, sessionValid: true, cajaId: data.cajaId || String(session.caja_id || \u0027\u0027), fondoInicial: Number(session.fondo_inicial || 0) } }];\n} catch (error) {\n  return [{ json: { ok: false, sessionValid: false, error: \u0027CASH_CLOSE_ERROR\u0027, message: \u0027No se pudo cerrar la caja\u0027 } }];\n}"
