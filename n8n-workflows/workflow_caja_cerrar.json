                                         "jsCode":  "try {\n  const data = $items(\u0027ValidarSesion\u0027)[0]?.json || {};\n  const movements = $items(\u0027BuscarMovimientos\u0027).filter((item) =\u003e item.json \u0026\u0026 item.json.id \u0026\u0026 !item.json.error).map((item) =\u003e item.json.fields || item.json);\n  const queryError = $items(\u0027BuscarMovimientos\u0027).find((item) =\u003e item.json \u0026\u0026 (item.json.error || item.json.message) \u0026\u0026 !item.json.id);\n  if (queryError) {\n    return [{ json: { ok: false, totalsReady: false, error: \u0027CASH_CLOSE_ERROR\u0027, message: \u0027No se pudo cerrar la caja\u0027 } }];\n  }\n  const money = (value) =\u003e Math.round(Number(value || 0) * 100) / 100;\n  const activeMovements = movements.filter((movement) =\u003e [\u0027ACTIVO\u0027, \u0027CONFIRMADO\u0027, \u0027CONFIRMADA\u0027].includes(String(movement.estado || \u0027\u0027).toUpperCase()));\n  const ingresos = activeMovements.filter((movement) =\u003e String(movement.tipo || \u0027\u0027).toUpperCase() === \u0027INGRESO\u0027).reduce((sum, movement) =\u003e sum + Number(movement.importe || 0), 0);\n  const egresos = activeMovements.filter((movement) =\u003e String(movement.tipo || \u0027\u0027).toUpperCase() === \u0027EGRESO\u0027).reduce((sum, movement) =\u003e sum + Number(movement.importe || 0), 0);\n  const totalEsperado = money(Number(data.fondoInicial || 0) + ingresos - egresos);\n  const diferencia = money(data.totalContado - totalEsperado);\n\n  return [{ json: {\n    ok: true,\n    totalsReady: true,\n    id: data.cajaSesionId,\n    cajaSesionId: data.cajaSesionId,\n    operationId: data.operationId,\n    estado: \u0027CERRADA\u0027,\n    fecha_cierre: data.fechaHora,\n    total_esperado: totalEsperado,\n    total_contado: data.totalContado,\n    diferencia,\n    observaciones: data.observaciones,\n    operation_id_cierre: data.operationId,\n    totalEsperado,\n    totalContado: data.totalContado,\n    fechaCierre: data.fechaHora,\n    idempotent: false\n  } }];\n} catch (error) {\n  return [{ json: { ok: false, totalsReady: false, error: \u0027CASH_CLOSE_ERROR\u0027, message: \u0027No se pudo cerrar la caja\u0027 } }];\n}"
