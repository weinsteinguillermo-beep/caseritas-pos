dation.cajaId,\n        fondoInicial: Number(fields.fondo_inicial || 0),\n        fechaApertura: fields.fecha_apertura || null,\n        estado: fields.estado || \u0027ABIERTA\u0027\n      }\n    }\n  ];\n} catch (error) {\n  return [\n    {\n      json: {\n        ok: false,\n        error: \u0027CASH_STATUS_ERROR\u0027,\n        message: \u0027No se pudo consultar el estado de la caja\u0027\n      }\n    }\n  ];\n}"
