                      "type":  "n8n-nodes-base.airtable",
                      "typeVersion":  2.1,
                      "position":  [
                                       520,
                                       0
                                   ],
                      "alwaysOutputData":  true,
                      "continueOnFail":  true
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "try {\n  const validation = $items(\u0027Validacion\u0027)[0]?.json || {};\n\n  if (validation.validationError) {\n    return [\n      {\n        json: {\n          ok: false,\n          error: validation.error || \u0027PRODUCT_CODE_REQUIRED\u0027,\n          message: validation.message || \u0027Ingresa un codigo de barras valido\u0027\n        }\n      }\n    ];\n  }\n\n  const airtableItems = $items(\u0027Airtable\u0027);\n  const airtableError = airtableItems.find(item =\u003e item.json \u0026\u0026 (item.json.error || item.json.message) \u0026\u0026 !item.json.id);\n\n  if (airtableError) {\n    return [\n      {\n        json: {\n          ok: false,\n          error: \u0027PRODUCT_LOOKUP_ERROR\u0027,\n          message: \u0027No se pudo consultar el producto\u0027\n        }\n      }\n    ];\n  }\n\n  const item = airtableItems.find(entry =\u003e entry.json \u0026\u0026 entry.json.id);\n\n  if (!item) {\n    return [\n      {\n        json: {\n          ok: true,\n          producto: null\n        }\n      }\n    ];\n  }\n\n  const record = item.json.fields || item.json;\n  const barcode = record[\u0027Codigo de Barras\u0027];\n\n  return [\n    {\n      json: {\n        ok: true,\n        producto: {\n          id: item.json.id,\n          name: record.Name || \u0027\u0027,\n          barcode: barcode?.text || barcode || \u0027\u0027,\n          price: Number(record.Importe || record[\u0027Precio x Kg\u0027] || 0),\n          weight: Number(record.Peso || 0),\n          stock: Number(record[\u0027Stock Actual\u0027] || 0)\n        }\n      }\n    }\n  ];\n} catch (error) {\n  return [\n    {\n      json: {\n        ok: false,\n        error: \u0027PRODUCT_LOOKUP_ERROR\u0027,\n        message: \u0027No se pudo consultar el producto\u0027\n      }\n    }\n  ];\n}"
                                     },
