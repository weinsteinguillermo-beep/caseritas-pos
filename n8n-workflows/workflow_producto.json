                      "parameters":  {
                                         "jsCode":  "const code = String($json.query?.code || \u0027\u0027).trim();\nconst safeCode = code.replace(/\\\\/g, \u0027\\\\\\\\\u0027).replace(/\"/g, \u0027\\\\\"\u0027);\n\nif (!code) {\n  return [\n    {\n      json: {\n        ok: false,\n        validationError: true,\n        error: \u0027PRODUCT_CODE_REQUIRED\u0027,\n        message: \u0027Ingresa un codigo de barras valido\u0027,\n        code: \u0027\u0027\n      }\n    }\n  ];\n}\n\nreturn [\n  {\n    json: {\n      ok: true,\n      code,\n      formula: `({Codigo de Barras} \u0026 \"\") = \"${safeCode}\"`\n    }\n  }\n];"
                                     },
